# Turso / libSQL - needed only for online multiplayer with friends.
# Solo vs. bots works completely without any database or sign-in.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-db-token

# Optional: lets the bots invent word lists for brand-new custom categories
# via the Claude API. Without it they fall back to the built-in heuristics.
ANTHROPIC_API_KEY=
